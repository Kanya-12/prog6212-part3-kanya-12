@model ParticipantEventsVm
@{
    ViewData["Title"] = "Events";
    var f = Model.Filter;
}

<div class="rd-page-header">
    <div>
        <h1 class="rd-title mb-1">Upcoming events</h1>
        <p class="text-muted mb-0">Find a start line, then open an event to see its categories and enter.</p>
    </div>
</div>

<form method="get" asp-action="Index" class="card rd-card rd-filter p-3 mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-6 col-lg-3">
            <label class="form-label small mb-1">Search</label>
            <input type="text" name="Search" value="@f.Search" class="form-control" placeholder="Name or location" />
        </div>
        <div class="col-md-6 col-lg-2">
            <label class="form-label small mb-1">Type</label>
            <select name="EventType" class="form-select">
                <option value="">All types</option>
                <option value="Running" selected="@(f.EventType == "Running")">Running</option>
                <option value="Walking" selected="@(f.EventType == "Walking")">Walking</option>
                <option value="Cycling" selected="@(f.EventType == "Cycling")">Cycling</option>
            </select>
        </div>
        <div class="col-6 col-lg-1">
            <label class="form-label small mb-1">Min km</label>
            <input type="number" name="MinDistance" value="@f.MinDistance" class="form-control" min="0" step="0.1" />
        </div>
        <div class="col-6 col-lg-1">
            <label class="form-label small mb-1">Max km</label>
            <input type="number" name="MaxDistance" value="@f.MaxDistance" class="form-control" min="0" step="0.1" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small mb-1">From</label>
            <input type="date" name="DateFrom" value="@(f.DateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small mb-1">To</label>
            <input type="date" name="DateTo" value="@(f.DateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-12 col-lg-1 d-flex gap-2">
            <button type="submit" class="btn rd-btn-primary flex-fill">Go</button>
        </div>
    </div>
    @if (f.IsFiltered)
    {
        <div class="mt-2 small">
            Showing @Model.Events.Count of @Model.TotalUpcoming upcoming events.
            <a asp-action="Index">Clear filters</a>
        </div>
    }
</form>

@if (!Model.Events.Any())
{
    <div class="card rd-card">
        <div class="card-body text-center py-5">
            @if (f.IsFiltered)
            {
                <h2 class="rd-title">No events match your filters</h2>
                <p class="text-muted">Try widening the distance or dates, or <a asp-action="Index">clear the filters</a>.</p>
            }
            else
            {
                <h2 class="rd-title">No upcoming events yet</h2>
                <p class="text-muted mb-0">Check back soon. New events appear here as organisers add them.</p>
            }
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card rd-card rd-event-card">
                    <partial name="_EventBanner" model="ev" />
                    <div class="card-body d-flex flex-column">
                        <h2 class="h4 mb-2">@ev.EventName</h2>
                        <div class="rd-meta mb-2">
                            <span>@UiFormat.Date(ev.EventDate)</span>
                            <span>@ev.Location</span>
                        </div>
                        <p class="text-muted mb-3">@UiFormat.Distance(ev.DistanceKm) &middot; organised by @ev.OrganiserName</p>
                        <a class="btn rd-btn-primary mt-auto" asp-action="Details" asp-route-id="@ev.EventId">View details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
