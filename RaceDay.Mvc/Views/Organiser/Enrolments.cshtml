@model EnrolmentsPageVm
@{
    ViewData["Title"] = "Enrolments";
    var pending = Model.Enrolments.Count(e => e.Status == "Pending");
    var confirmed = Model.Enrolments.Count(e => e.Status == "Confirmed");
    var cancelled = Model.Enrolments.Count(e => e.Status == "Cancelled");
}

<div class="rd-page-header">
    <div>
        <h1 class="rd-title mb-1">Enrolments</h1>
        <p class="text-muted mb-0">@Model.Event.EventName &middot; @UiFormat.Date(Model.Event.EventDate) &middot; @Model.Event.Location</p>
    </div>
    <a class="btn btn-outline-dark" asp-action="Events">Back to my events</a>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <span class="rd-status status-confirmed">@confirmed confirmed</span>
    <span class="rd-status status-pending">@pending pending</span>
    <span class="rd-status status-cancelled">@cancelled cancelled</span>
</div>

<div class="card rd-card">
    <div class="card-body">
        @if (!Model.Enrolments.Any())
        {
            <p class="text-muted mb-0">Nobody has enrolled for this event yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table rd-table align-middle">
                    <thead>
                        <tr>
                            <th>Participant</th>
                            <th>Category</th>
                            <th>Enrolled on</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th>Change status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Enrolments)
                        {
                            <tr>
                                <td><strong>@e.ParticipantName</strong></td>
                                <td>@e.CategoryName</td>
                                <td>@UiFormat.Date(e.EnrolmentDate)</td>
                                <td><span class="rd-status @UiFormat.StatusClass(e.Status)">@e.Status</span></td>
                                <td><span class="rd-status @UiFormat.StatusClass(e.PaymentStatus)">@e.PaymentStatus</span></td>
                                <td>
                                    <form asp-action="UpdateEnrolmentStatus" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="enrolmentId" value="@e.EnrolmentId" />
                                        <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                                        <select name="status" class="form-select form-select-sm">
                                            <option value="Pending" selected="@(e.Status == "Pending")">Pending</option>
                                            <option value="Confirmed" selected="@(e.Status == "Confirmed")">Confirmed</option>
                                            <option value="Cancelled" selected="@(e.Status == "Cancelled")">Cancelled</option>
                                        </select>
                                        <button type="submit" class="btn btn-outline-dark btn-sm">Update</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
