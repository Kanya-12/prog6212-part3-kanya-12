@model CategoryFormVm

<input asp-for="CategoryId" type="hidden" />
<input asp-for="EventId" type="hidden" />

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="CategoryName" class="form-label"></label>
        <input asp-for="CategoryName" class="form-control" placeholder="e.g. 21.1km Half Marathon, Under 20, Senior" />
        <span asp-validation-for="CategoryName" class="text-danger"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" class="form-control" type="number" step="0.01" min="0.1" />
        <span asp-validation-for="DistanceKm" class="text-danger"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="EntryFee" class="form-label"></label>
        <input asp-for="EntryFee" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="EntryFee" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-3">
        <label asp-for="MinAge" class="form-label"></label>
        <input asp-for="MinAge" class="form-control" type="number" min="0" max="120" />
        <span asp-validation-for="MinAge" class="text-danger"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="MaxAge" class="form-label"></label>
        <input asp-for="MaxAge" class="form-control" type="number" min="0" max="120" />
        <span asp-validation-for="MaxAge" class="text-danger"></span>
    </div>
</div>
